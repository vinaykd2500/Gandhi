<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="section-title">
      <small>Get in Touch</small>
      <h2>Contact & Business Inquiries</h2>
    </div>

    <% if (success) { %>
    <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: #166534; padding: 14px 18px; border-radius: 12px; margin-bottom: 26px; text-align: center; font-weight: 700;">
      Thank you! Your inquiry has been submitted and our sales team will get back to you shortly.
    </div>
    <% } %>
    <% if (error) { %>
    <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); color: #b91c1c; padding: 14px 18px; border-radius: 12px; margin-bottom: 26px; text-align: center; font-weight: 700;">
      <%= error %>. Please try again.
    </div>
    <% } %>

    <div class="contact-grid">
      <div class="contact-card">
        <h3>Direct factory contact</h3>

        <div class="contact-detail">
          <strong>Factory & registered address</strong>
          <p><%= company.address %></p>
        </div>

        <div class="contact-detail">
          <strong>Phone number</strong>
          <p><a href="tel:<%= company.phone %>"><%= company.phone %></a></p>
        </div>

        <div class="contact-detail">
          <strong>Email desk</strong>
          <p><a href="mailto:<%= company.email %>"><%= company.email %></a></p>
        </div>

        <a href="https://wa.me/<%= company.whatsapp %>?text=Hello%20Jeson%20International,%20I%20want%20to%20inquire%20about%20bulk%20supply" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp" style="width: 100%;">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>&nbsp; Chat on WhatsApp
        </a>
      </div>

      <div class="contact-card">
        <h3>Send inquiry / request quotation</h3>
        <form action="/contact-us" method="POST" class="contact-form">
          <div>
            <label for="name">Full name *</label><input id="name" type="text" name="name" required autocomplete="name">
          </div>

          <div class="form-row">
            <div>
              <label for="phone">Phone / WhatsApp *</label><input id="phone" type="tel" name="phone" required autocomplete="tel">
            </div>
            <div>
              <label for="email">Email address</label><input id="email" type="email" name="email" autocomplete="email">
            </div>
          </div>

          <div>
            <label for="sinkModel">Interested product / model</label><input id="sinkModel" type="text" name="sinkModel" placeholder="e.g. Handmade sinks or dual cisterns">
          </div>

          <div>
            <label for="message">Order requirements & specifications *</label><textarea id="message" name="message" rows="4" placeholder="Mention sizes, quantity, or delivery city..." required></textarea>
          </div>

          <div>
            <label for="contactCaptcha">Verification: What is <%= captcha.question %>?</label>
            <input id="contactCaptcha" type="number" name="captchaAnswer" required inputmode="numeric" autocomplete="off">
          </div>

          <button type="submit" class="btn btn-primary">Submit inquiry <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
        </form>
      </div>
    </div>

    <div class="map-frame">
      <iframe src="https://maps.google.com/maps?q=Usha%20Complex%20Society%20Rd,%20Bhandup%20West,%20Mumbai,%20Maharashtra%20400078&t=&z=14&ie=UTF8&iwloc=&output=embed" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
