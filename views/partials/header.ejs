 <!DOCTYPE html>
 <html lang="en">

 <head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title><%= typeof title !== 'undefined' ? title : company.name %></title>
   <meta name="description" content="Jeson International manufactures premium kitchen sinks, cisterns, wash basins and plumbing fittings for dealers, distributors and project buyers across India.">
   <meta name="theme-color" content="#081321">
   <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : company.name %>">
   <meta property="og:description" content="Premium sanitaryware and plumbing products supplied directly to trade and project buyers.">
   <meta property="og:type" content="website">
   <meta property="og:url" content="<%= company.website %>">
   <link rel="stylesheet" href="/css/base.css">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">

   <% if (typeof pageCss !== 'undefined') { %>
   <link rel="stylesheet" href="/css/<%= pageCss %>.css">
   <% } %>

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
 </head>

 <body>
   <header class="site-header">
     <div class="container header-inner">
       <a href="/" class="brand-logo">
         <img src="/images/logo.png" alt="<%= company.name %> logo" class="logo-img" width="48" height="48">
         <div class="brand-text">
           <strong><%= company.name %></strong>
           <small><%= company.tagline %></small>
         </div>
       </a>

       <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-navigation">
         <i class="fa-solid fa-bars" aria-hidden="true"></i>
       </button>

       <nav class="nav-menu" id="primary-navigation" aria-label="Main navigation">
         <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
         <a href="/products" class="<%= currentPath === '/products' ? 'active' : '' %>">Catalogue</a>
         <a href="/gallery" class="<%= currentPath === '/gallery' ? 'active' : '' %>">Gallery</a>
         <a href="/about-us" class="<%= currentPath === '/about-us' ? 'active' : '' %>">About Us</a>
         <!-- <a href="/contact-us" class="<%= currentPath === '/contact-us' ? 'active' : '' %>">Contact</a> -->
         <a href="/contact-us" class="header-cta">Request Quote</a>
       </nav>
     </div>
   </header>
   <div class="nav-backdrop" aria-hidden="true"></div>
   <script>
     (() => {
       const toggle = document.querySelector('.menu-toggle');
       const menu = document.querySelector('.nav-menu');
       const backdrop = document.querySelector('.nav-backdrop');
       if (!toggle || !menu || !backdrop) return;
       const closeMenu = () => {
         menu.classList.remove('open');
         backdrop.classList.remove('open');
         toggle.setAttribute('aria-expanded', 'false');
       };
       toggle.addEventListener('click', () => {
         const isOpen = menu.classList.toggle('open');
         backdrop.classList.toggle('open', isOpen);
         toggle.setAttribute('aria-expanded', String(isOpen));
       });
       backdrop.addEventListener('click', closeMenu);
       menu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
       document.addEventListener('keydown', event => {
         if (event.key === 'Escape') closeMenu();
       });
     })();

   </script>