<%- include('partials/header') %>

<section class="hero-section about-hero">
  <div class="container hero-content">
    <span class="hero-badge">Our Legacy</span>
    <h1>About Jeson International</h1>
    <p>Pioneering high-durability sanitary fittings, kitchen sinks, and modern bathroom infrastructure with manufacturing excellence and trust.</p>
  </div>
</section>

<section class="section about-intro">
  <div class="container">
    <div class="section-title">
      <small>Our Journey</small>
      <h2>Company History & Legacy</h2>
    </div>
    <div class="split-copy" style="max-width: 820px; margin: 0 auto; text-align: center;">
      <p>
        Founded with a vision to revolutionize plumbing and sanitaryware manufacturing, <strong>Jeson International</strong> has grown into a trusted supplier for builders, plumbing contractors, and hardware distributors across India.
      </p>
      <p style="margin-top: 16px;">
        Starting from a focused fabrication shop, continuous modernization and integration of deep-draw hydraulic machinery have positioned us as a single-point vendor for residential, commercial, and industrial sanitary solutions.
      </p>
    </div>
  </div>
</section>

<section class="section about-infrastructure" style="background: #edf3f6;">
  <div class="container">
    <div class="section-title">
      <small>Infrastructure</small>
      <h2>Manufacturing Capability</h2>
    </div>

    <div class="grid grid-3">
      <div class="feature-box">
        <div class="card-icon"><i class="fa-solid fa-crosshairs"></i></div>
        <h3>Precision Pressing</h3>
        <p>Equipped with multi-ton hydraulic press machines engineered for deep-draw seamless kitchen sinks without structural stress or wall thinning.</p>
      </div>

      <div class="feature-box">
        <div class="card-icon"><i class="fa-solid fa-mound"></i></div>
        <h3>Polymer Moulding</h3>
        <p>High-tonnage injection moulding machinery capable of producing heavy-duty, leakage-resistant cistern bodies and precision internal valves.</p>
      </div>

      <div class="feature-box">
        <div class="card-icon"><i class="fa-solid fa-vial-circle-check"></i></div>
        <h3>Quality & Batch Testing</h3>
        <p>Rigorous drop testing, chemical corrosion checks, and pressure testing across all pipe couplings and drain assemblies.</p>
      </div>
    </div>
  </div>
</section>

<section class="section about-values">
  <div class="container">
    <div class="grid grid-3">
      <div class="category-card">
        <div class="card-icon"><i class="fa-solid fa-bullseye" aria-hidden="true"></i></div>
        <h3>Our Mission</h3>
        <p>To produce reliable, high-grade sanitary solutions that combine functional ergonomics, effortless installation, and lifelong corrosion resistance at factory-direct pricing.</p>
      </div>

      <div class="category-card">
        <div class="card-icon"><i class="fa-solid fa-eye" aria-hidden="true"></i></div>
        <h3>Our Vision</h3>
        <p>To establish Jeson International as the premier OEM partner and wholesale sanitaryware brand nationwide, standardizing quality and rapid supply chain turnaround.</p>
      </div>

      <div class="category-card">
        <div class="card-icon"><i class="fa-solid fa-handshake" aria-hidden="true"></i></div>
        <h3>Our Promise</h3>
        <p>To deliver dependable products, responsive service, and long-term trust to contractors, retail partners, and project buyers across India.</p>
      </div>
    </div>
  </div>
</section>

