  <!DOCTYPE html>
  <html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Jeson International</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon"  href="/favicon.ico">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }

      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at top right, #1e293b, #0b1329);
        padding: 20px;
      }

      .login-container {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 16px;
        padding: 36px 32px;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .brand-header {
        text-align: center;
        margin-bottom: 28px;
      }

      .brand-icon {
        width: 52px;
        height: 52px;
        background: #0284c7;
        color: #fff;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 12px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
      }

      .brand-header h2 {
        font-size: 22px;
        color: #0f172a;
        letter-spacing: -0.5px;
      }

      .brand-header p {
        font-size: 13px;
        color: #64748b;
        margin-top: 4px;
      }

      .error-alert {
        background: #fee2e2;
        border: 1px solid #fecaca;
        color: #dc2626;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .form-group {
        margin-bottom: 18px;
      }

      .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 7px;
      }

      .input-wrapper {
        position: relative;
      }

      .input-wrapper i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 14px;
      }

      .form-control {
        width: 100%;
        padding: 12px 14px 12px 40px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        background: #f8fafc;
      }

      .form-control:focus {
        background: #fff;
        border-color: #0284c7;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
      }

      .btn-login {
        width: 100%;
        background: #0284c7;
        color: #ffffff;
        padding: 12px;
        border-radius: 8px;
        border: none;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 24px;
        transition: background 0.2s, transform 0.1s;
      }

      .btn-login:hover {
        background: #0369a1;
      }

      .btn-login:active {
        transform: scale(0.99);
      }

      .back-home {
        text-align: center;
        margin-top: 22px;
      }

      .back-home a {
        color: #64748b;
        font-size: 13px;
        text-decoration: none;
        transition: color 0.2s;
      }

      .back-home a:hover {
        color: #0284c7;
      }

    </style>
  </head>

  <body>

    <div class="login-container">
      <div class="brand-header">
        <div class="brand-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h2>Jeson International</h2>
        <p>Authorized Admin Portal Access</p>
      </div>

      <% if (error) { %>
      <div class="error-alert" id="login-error" role="alert">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= error %></span>
      </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label>Username</label>
          <div class="input-wrapper">
            <i class="fa-regular fa-user"></i>
            <input type="text" name="username" class="form-control" placeholder="Enter admin username" required autocomplete="off">
          </div>
        </div>

        <div class="form-group">
          <label>Password</label>
          <div class="input-wrapper">
            <i class="fa-solid fa-lock"></i>
            <input type="password" name="password" class="form-control" placeholder="••••••••" required>
          </div>
        </div>

        <div class="form-group">
          <label for="loginCaptcha">Verification: What is <%= captcha.question %>?</label>
          <div class="input-wrapper">
            <i class="fa-solid fa-calculator"></i>
            <input id="loginCaptcha" type="number" name="captchaAnswer" class="form-control" required inputmode="numeric" autocomplete="off">
          </div>
        </div>

        <button type="submit" class="btn-login">
          <span>Sign In to Dashboard</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <div class="back-home">
        <a href="/">&larr; Return to Live Website</a>
      </div>
    </div>

    <script>
      const loginError = document.getElementById('login-error');
      if (loginError) {
        setTimeout(() => loginError.remove(), 5000);
      }

      const loginForm = document.querySelector('form[action="/admin/login"]');
      loginForm.addEventListener('keydown', event => {
        if (event.key === 'Enter') {
          event.preventDefault();
          loginForm.requestSubmit();
        }
      });
    </script>

  </body>

  </html>
